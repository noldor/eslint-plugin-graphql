{
  "name": "@noldor/eslint-plugin-graphql",
  "version": "0.0.1",
  "description": "GraphQL ESLint rules for documented schemas and explicit identifier contracts",
  "type": "module",
  "license": "MIT",
  "exports": "./src/index.js",
  "files": ["src", "docs", "README.md", "LICENSE"],
  "engines": { "node": ">=20.19.0" },
  "peerDependencies": {
    "@graphql-eslint/eslint-plugin": "^4.4.2",
    "eslint": "^9.39.0 || ^10.0.0",
    "graphql": "^16.0.0"
  },
  "devDependencies": {
    "@graphql-eslint/eslint-plugin": "4.4.2",
    "eslint": "10.13.0",
    "graphql": "16.14.2"
  },
  "overrides": { "@graphql-tools/utils": "12.0.2" },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && npm test && node scripts/verify-package.js",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/noldor/eslint-plugin-graphql.git" }
